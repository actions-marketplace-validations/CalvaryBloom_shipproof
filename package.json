{
  "name": "shipproof",
  "version": "0.2.0",
  "description": "Zero-config release readiness checks for AI-assisted projects.",
  "type": "module",
  "bin": {
    "shipproof": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "docs/*.svg",
    "README.md",
    "README.es.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/test/analyze.test.js dist/test/github-action.test.js",
    "start": "node dist/src/cli.js",
    "prepare": "tsc -p tsconfig.json",
    "prepack": "pnpm test"
  },
  "keywords": [
    "ai",
    "cli",
    "code-quality",
    "developer-tools",
    "release-readiness",
    "security"
  ],
  "author": "CalvaryBloom",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CalvaryBloom/shipproof.git"
  },
  "bugs": {
    "url": "https://github.com/CalvaryBloom/shipproof/issues"
  },
  "homepage": "https://github.com/CalvaryBloom/shipproof#readme",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.15.0",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
